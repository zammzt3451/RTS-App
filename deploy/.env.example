# Port on localhost the app listens on (your web server proxies to it). Pick one that's free.
RTS_PORT=3070
# Where your data lives on the server. Back this folder up.
RTS_DATA_DIR=./data
# User/group IDs that own RTS_DATA_DIR (run `id` to see yours).
RTS_UID=1000
RTS_GID=1000
# Optional: your own one-time setup code. If blank, one is printed in `docker compose logs`.
SETUP_CODE=
